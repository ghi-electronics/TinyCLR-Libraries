<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- packages.config projects only: inject the <Reference>s (CLI `nuget restore` does not add
       them to the csproj, unlike the VS Package Manager UI). Two DLLs ship in this one package -
       the Data.Xml impl (old public API) and the System.Xml facade (Microsoft-compatible API) -
       just like Devices.Gpio ships both Devices.Gpio.dll and System.Device.Gpio.dll. SDK-style
       (PackageReference) projects ignore this file and auto-reference both from lib\net48. -->
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Data.Xml">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Data.Xml.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="GHIElectronics.TinyCLR.System.Xml">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.System.Xml.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRDataXmlImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Data.Xml.dll</_TinyCLRDataXmlImplSource>
    <_TinyCLRSystemXmlImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.System.Xml.dll</_TinyCLRSystemXmlImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRDataXmlImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDataXmlImplSource)')">
    <Copy SourceFiles="$(_TinyCLRDataXmlImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Data.Xml.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRSystemXmlImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRSystemXmlImplSource)')">
    <Copy SourceFiles="$(_TinyCLRSystemXmlImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.System.Xml.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
