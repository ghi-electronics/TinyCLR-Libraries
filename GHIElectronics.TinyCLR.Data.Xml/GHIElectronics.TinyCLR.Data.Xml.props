<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Consumer-side props imported by user projects via the NuGet package mechanism.
     References come from lib\net48 directly: packages.config projects via the literal <Reference>
     the VS Package Manager adds at install time, PackageReference projects automatically. This file
     injects NO <Reference> - doing so made VS's classic project system render a spurious unresolved
     0.0.0.0 reference (yellow warning) in Solution Explorer, because VS reads props <Reference>
     elements ignoring their Condition. V2 device packages shipped no props here and were clean.
     This file only stages the impl DLL(s) into pe\ so the debugger can resolve them. -->
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRDataXmlImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Data.Xml.dll</_TinyCLRDataXmlImplSource>
    <_TinyCLRSystemXmlImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.System.Xml.dll</_TinyCLRSystemXmlImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRDataXmlImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDataXmlImplSource)')">
    <Copy SourceFiles="$(_TinyCLRDataXmlImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Data.Xml.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRSystemXmlImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRSystemXmlImplSource)')">
    <Copy SourceFiles="$(_TinyCLRSystemXmlImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.System.Xml.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
