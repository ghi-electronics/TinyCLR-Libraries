<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Data.Xml">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Data.Xml.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRDataXmlImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Data.Xml.dll</_TinyCLRDataXmlImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRDataXmlImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDataXmlImplSource)')">
    <Copy SourceFiles="$(_TinyCLRDataXmlImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Data.Xml.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
