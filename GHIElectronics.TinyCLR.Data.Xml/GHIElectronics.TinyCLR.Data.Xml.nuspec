<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.Data.Xml</id>
    <version>3.0.1.1000-prerelease</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>XML reading and writing for TinyCLR.</description>
    <copyright>Copyright GHI Electronics, LLC 2026</copyright>
    <tags>TinyCLR TinyCLROS</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.1.1000-prerelease" />
    </dependencies>
  </metadata>
  <files>
    <!-- One package, two DLLs (same as Devices.Gpio which ships Devices.Gpio.dll +
         System.Device.Gpio.dll): the Data.Xml impl exposes the original public API so
         2.x/legacy code (using GHIElectronics.TinyCLR.Data.Xml) compiles unchanged, and the
         System.Xml facade (built + copied into $TargetDir$ by BuildXmlCompatAssembly) exposes
         the Microsoft-compatible API (using System.Xml). SDK-style projects auto-reference both
         from lib\net48; packages.config projects get both via the build\net48 props. -->
    <file src="$TargetDir$GHIElectronics.TinyCLR.Data.Xml.dll" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.Data.Xml.xml" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.System.Xml.dll" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.System.Xml.xml" target="lib\net48" />
    <file src="$ProjectDir$GHIElectronics.TinyCLR.Data.Xml.props" target="build\net48" />
  </files>
</package>
