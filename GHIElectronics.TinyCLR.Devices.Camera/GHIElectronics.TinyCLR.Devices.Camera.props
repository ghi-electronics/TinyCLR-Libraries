<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Camera">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Camera.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRDevicesCameraImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Camera.dll</_TinyCLRDevicesCameraImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRDevicesCameraImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDevicesCameraImplSource)')">
    <Copy SourceFiles="$(_TinyCLRDevicesCameraImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Camera.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
