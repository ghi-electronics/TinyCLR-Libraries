<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Network">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Network.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRNetworkShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.Network.dll</_TinyCLRNetworkShimSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRNetworkDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRNetworkShimSource)')">
    <Copy SourceFiles="$(_TinyCLRNetworkShimSource)"
          DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.Network.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
