<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRDevicesNetworkImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Network.dll</_TinyCLRDevicesNetworkImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRDevicesNetworkImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDevicesNetworkImplSource)')">
    <Copy SourceFiles="$(_TinyCLRDevicesNetworkImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Network.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
