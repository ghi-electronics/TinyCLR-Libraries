<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Data.SQLite" Condition="'$(NuGetProjectStyle)' != 'PackageReference'">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Data.SQLite.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRDataSQLiteShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Data.SQLite.dll</_TinyCLRDataSQLiteShimSource>
    <_TinyCLRDataSQLiteImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.Data.SQLite.dll</_TinyCLRDataSQLiteImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRDataSQLiteDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDataSQLiteShimSource)')">
    <Copy SourceFiles="$(_TinyCLRDataSQLiteShimSource)" DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Data.SQLite.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRDataSQLiteImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRDataSQLiteImplSource)')">
    <Copy SourceFiles="$(_TinyCLRDataSQLiteImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Data.SQLite.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
