<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.RegularExpressions">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.RegularExpressions.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRRegexImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.RegularExpressions.dll</_TinyCLRRegexImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRRegexImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRRegexImplSource)')">
    <Copy SourceFiles="$(_TinyCLRRegexImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.RegularExpressions.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
