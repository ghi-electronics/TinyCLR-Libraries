<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Spi">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Spi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRSpiShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.Spi.dll</_TinyCLRSpiShimSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRSpiDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRSpiShimSource)')">
    <Copy SourceFiles="$(_TinyCLRSpiShimSource)"
          DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.Spi.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
