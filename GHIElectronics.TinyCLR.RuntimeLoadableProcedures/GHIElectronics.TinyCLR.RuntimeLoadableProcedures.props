<?xml version="1.0" encoding="utf-8"?>

<!-- Consumer-side props imported by user projects via the NuGet package
     mechanism. See GHIElectronics.TinyCLR.Native.props for full commentary
     on why a Target is used instead of <None Include>. -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.RuntimeLoadableProcedures" Condition="'$(NuGetProjectStyle)' != 'PackageReference'">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.RuntimeLoadableProcedures.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRRlpShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.RuntimeLoadableProcedures.dll</_TinyCLRRlpShimSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRRuntimeLoadableProceduresDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRRlpShimSource)')">
    <Copy SourceFiles="$(_TinyCLRRlpShimSource)"
          DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.RuntimeLoadableProcedures.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
