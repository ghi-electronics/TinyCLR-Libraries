<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLREipAdapterImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.EthernetIP.Adapter.dll</_TinyCLREipAdapterImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLREipAdapterImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLREipAdapterImplSource)')">
    <Copy SourceFiles="$(_TinyCLREipAdapterImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.EthernetIP.Adapter.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
