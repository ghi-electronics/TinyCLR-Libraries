<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.EthernetIP.Adapter</id>
    <version>3.0.0.1000-prerelease</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>EtherNet/IP adapter (industrial fieldbus device) for TinyCLR OS.</description>
    <copyright>Copyright GHI Electronics, LLC 2022</copyright>
    <tags>TinyCLR TinyCLROS</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.0.1000-prerelease" />
      <dependency id="GHIElectronics.TinyCLR.Networking" version="3.0.0.1000-prerelease" />      
	  <dependency id="GHIElectronics.TinyCLR.Native" version="3.0.0.1000-prerelease" />      
    </dependencies>
  </metadata>
  <files>
    <file src="$TargetDir$GHIElectronics.TinyCLR.EthernetIP.Adapter.dll" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.EthernetIP.Adapter.xml" target="lib\net48" />
    <file src="..\GHIElectronics.TinyCLR.EthernetIP.Adapter.Desktop\bin\$Configuration$\GHIElectronics.TinyCLR.EthernetIP.Adapter.dll" target="desktop-shim" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.EthernetIP.Adapter.xml" target="desktop-shim" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.EthernetIP.Adapter.dll" target="tinyclr" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.EthernetIP.Adapter.xml" target="tinyclr" />
    <file src="$ProjectDir$GHIElectronics.TinyCLR.EthernetIP.Adapter.props" target="build\net48" />
  </files>
</package>