<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRPinsImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Pins.dll</_TinyCLRPinsImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRPinsImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRPinsImplSource)')">
    <Copy SourceFiles="$(_TinyCLRPinsImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Pins.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
