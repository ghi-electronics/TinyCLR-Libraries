<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Pins" Condition="'$(NuGetProjectStyle)' != 'PackageReference'">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Pins.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRPinsShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Pins.dll</_TinyCLRPinsShimSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRPinsDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRPinsShimSource)')">
    <Copy SourceFiles="$(_TinyCLRPinsShimSource)"
          DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Pins.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
