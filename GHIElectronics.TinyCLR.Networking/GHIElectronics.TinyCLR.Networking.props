<?xml version="1.0" encoding="utf-8"?>

<!-- Consumer-side props imported by user projects via the NuGet package mechanism.

     References come from lib\net48 directly: packages.config projects via the literal <Reference>
     the VS Package Manager adds at install time, PackageReference projects automatically. This file
     injects NO <Reference> - VS's classic project system reads props <Reference> elements ignoring
     their Condition, so an injected one appeared as a spurious unresolved 0.0.0.0 reference (yellow
     warning) in Solution Explorer. V2 device packages shipped no props here and were clean.

     Debug-time staging (the only reason this file has a Target):
       The TinyCLR debugger reads CLR metadata via FindAssemblyOnDisk in CorDebugAssembly.cs; its
       first-tried path is "next to the .pdbx" = $(OutDir)pe\<asm>.dll. The AfterBuild target copies
       the impl DLL there so the debugger reads the same metadata MMP processed into the deployed
       .pe, and variable hover resolves correctly. -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRNetworkingImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Networking.dll</_TinyCLRNetworkingImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRNetworkingImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRNetworkingImplSource)')">
    <Copy SourceFiles="$(_TinyCLRNetworkingImplSource)"
          DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Networking.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
