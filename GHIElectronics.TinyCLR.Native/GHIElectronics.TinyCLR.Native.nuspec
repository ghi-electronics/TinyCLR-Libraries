<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.Native</id>
    <version>3.0.1.1000-prerelease</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Low-level native and system access for TinyCLR.</description>
    <copyright>Copyright GHI Electronics, LLC 2026</copyright>
    <tags>TinyCLR TinyCLROS</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.1.1000-prerelease" />
    </dependencies>
  </metadata>
  <files>
    <!-- lib/net48/ : TinyCLR-IMPL DLL. Auto-referenced for compile by classic
         packages.config NuGet. Compile-time only — .props sets Private=False
         so it does NOT end up in bin\$Configuration$\. -->
    <file src="$TargetDir$GHIElectronics.TinyCLR.Native.dll" target="lib\net48" />

    <file src="$TargetDir$GHIElectronics.TinyCLR.Native.xml" target="lib\net48" />
    <!-- desktop-shim/ : Desktop SHIM DLL (no-op safe defaults). Copied to
         bin\$Configuration$\ at AfterBuild via a Target in the .props file. -->

    <!-- tinyclr/ : TinyCLR-IMPL DLL again. Read by the deploy step
         (DebugServer / VS extension), MMP'd into a .pe and pushed to device. -->

    <!-- Consumer-side props: imported via NuGet package convention. -->
    <file src="$ProjectDir$GHIElectronics.TinyCLR.Native.props" target="build\net48" />
  </files>
</package>
