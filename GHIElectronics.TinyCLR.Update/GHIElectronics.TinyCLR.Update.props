<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRUpdateImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Update.dll</_TinyCLRUpdateImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRUpdateImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUpdateImplSource)')">
    <Copy SourceFiles="$(_TinyCLRUpdateImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Update.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
