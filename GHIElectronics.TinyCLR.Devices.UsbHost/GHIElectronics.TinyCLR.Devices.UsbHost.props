<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.UsbHost" Condition="Exists('$(MSBuildProjectDirectory)\packages.config')">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.UsbHost.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRUsbHostShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.UsbHost.dll</_TinyCLRUsbHostShimSource>
    <_TinyCLRUsbHostImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.Devices.UsbHost.dll</_TinyCLRUsbHostImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRUsbHostDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUsbHostShimSource)')">
    <Copy SourceFiles="$(_TinyCLRUsbHostShimSource)" DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.UsbHost.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRUsbHostImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUsbHostImplSource)')">
    <Copy SourceFiles="$(_TinyCLRUsbHostImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.UsbHost.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
