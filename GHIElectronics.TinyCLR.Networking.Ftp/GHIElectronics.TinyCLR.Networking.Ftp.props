<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRNetworkingFtpImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Networking.Ftp.dll</_TinyCLRNetworkingFtpImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRNetworkingFtpImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRNetworkingFtpImplSource)')">
    <Copy SourceFiles="$(_TinyCLRNetworkingFtpImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Networking.Ftp.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
