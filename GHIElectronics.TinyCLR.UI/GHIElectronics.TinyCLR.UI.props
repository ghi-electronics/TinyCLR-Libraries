<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.UI">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRUIImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.UI.dll</_TinyCLRUIImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRUIImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUIImplSource)')">
    <Copy SourceFiles="$(_TinyCLRUIImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.UI.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
