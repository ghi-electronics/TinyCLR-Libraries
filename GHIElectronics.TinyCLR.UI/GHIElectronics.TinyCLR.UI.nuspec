<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.UI</id>
    <version>3.0.1.6000</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Graphical UI toolkit (controls, layout, touch input) for TinyCLR.</description>
    <copyright>Copyright GHI Electronics, LLC 2026</copyright>
    <tags>TinyCLR TinyCLROS</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.1.6000" />
      <dependency id="GHIElectronics.TinyCLR.Devices.Display" version="3.0.1.6000" />
      <dependency id="GHIElectronics.TinyCLR.Drawing" version="3.0.1.6000" />
    </dependencies>
  </metadata>
  <files>
    <file src="$TargetDir$GHIElectronics.TinyCLR.UI.dll" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.UI.xml" target="lib\net48" />
    <file src="$ProjectDir$GHIElectronics.TinyCLR.UI.props" target="build\net48" />
  </files>
</package>
