<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.EthernetIP.Scanner">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.EthernetIP.Scanner.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLREipScannerImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.EthernetIP.Scanner.dll</_TinyCLREipScannerImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLREipScannerImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLREipScannerImplSource)')">
    <Copy SourceFiles="$(_TinyCLREipScannerImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.EthernetIP.Scanner.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
