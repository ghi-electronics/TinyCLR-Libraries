<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Rtc" Condition="Exists('$(MSBuildProjectDirectory)\packages.config')">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Rtc.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRRtcShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.Rtc.dll</_TinyCLRRtcShimSource>
    <_TinyCLRRtcImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.Devices.Rtc.dll</_TinyCLRRtcImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRRtcDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRRtcShimSource)')">
    <Copy SourceFiles="$(_TinyCLRRtcShimSource)"
          DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.Rtc.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRRtcImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRRtcImplSource)')">
    <Copy SourceFiles="$(_TinyCLRRtcImplSource)"
          DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Rtc.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
