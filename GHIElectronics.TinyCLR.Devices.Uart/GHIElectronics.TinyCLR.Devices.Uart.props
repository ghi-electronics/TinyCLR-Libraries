<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Uart">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Uart.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRUartShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.Uart.dll</_TinyCLRUartShimSource>
    <_SystemIoPortsShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\System.IO.Ports.dll</_SystemIoPortsShimSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRUartDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUartShimSource)')">
    <Copy SourceFiles="$(_TinyCLRUartShimSource)"
          DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.Uart.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopySystemIoPortsDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_SystemIoPortsShimSource)')">
    <Copy SourceFiles="$(_SystemIoPortsShimSource)"
          DestinationFiles="$(OutDir)System.IO.Ports.dll"
          OverwriteReadOnlyFiles="true"
          SkipUnchangedFiles="false" />
  </Target>
</Project>
