<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.Devices.Uart</id>
    <version>3.0.1.2000-prerelease</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>UART serial-port communication for TinyCLR.</description>
    <copyright>Copyright GHI Electronics, LLC 2026</copyright>
    <tags>TinyCLR TinyCLROS</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.1.2000-prerelease" />
      <dependency id="GHIElectronics.TinyCLR.Native" version="3.0.1.2000-prerelease" />
    </dependencies>
  </metadata>
  <files>
    <!-- lib/net48/ : TinyCLR-IMPL DLLs (auto-referenced for compile). -->
    <file src="$TargetDir$GHIElectronics.TinyCLR.Devices.Uart.dll" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.Devices.Uart.xml" target="lib\net48" />

    <!-- System.IO.Ports (SerialPort) compat DLL (Microsoft-style API), TinyCLR-impl. -->
    <file src="$TargetDir$System.IO.Ports.dll" target="lib\net48" />
    <file src="$TargetDir$System.IO.Ports.xml" target="lib\net48" />



    <!-- Consumer-side props. -->
    <file src="$ProjectDir$GHIElectronics.TinyCLR.Devices.Uart.props" target="build\net48" />
  </files>
</package>
