<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Networking.Mqtt" Condition="Exists('$(MSBuildProjectDirectory)\packages.config')">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Networking.Mqtt.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRNetworkingMqttShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Networking.Mqtt.dll</_TinyCLRNetworkingMqttShimSource>
    <_TinyCLRNetworkingMqttImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.Networking.Mqtt.dll</_TinyCLRNetworkingMqttImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRNetworkingMqttDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRNetworkingMqttShimSource)')">
    <Copy SourceFiles="$(_TinyCLRNetworkingMqttShimSource)" DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Networking.Mqtt.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRNetworkingMqttImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRNetworkingMqttImplSource)')">
    <Copy SourceFiles="$(_TinyCLRNetworkingMqttImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Networking.Mqtt.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
