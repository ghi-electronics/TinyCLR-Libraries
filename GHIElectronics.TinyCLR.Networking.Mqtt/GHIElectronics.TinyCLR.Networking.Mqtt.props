<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRNetworkingMqttImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Networking.Mqtt.dll</_TinyCLRNetworkingMqttImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRNetworkingMqttImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRNetworkingMqttImplSource)')">
    <Copy SourceFiles="$(_TinyCLRNetworkingMqttImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Networking.Mqtt.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
