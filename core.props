<?xml version="1.0" encoding="utf-8"?>

<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <NoStdLib>true</NoStdLib>
    <AddAdditionalExplicitAssemblyReferences>false</AddAdditionalExplicitAssemblyReferences>
    <DisableHandlePackageFileConflicts>true</DisableHandlePackageFileConflicts>
    <!-- Suppress CS1591 + the malformed-XML family so undocumented public
         members don't flood the build log when doc generation is enabled
         per-csproj via <DocumentationFile>. -->
    <NoWarn>$(NoWarn);CS1591;CS1570;CS1572;CS1573;CS1574;CS1658</NoWarn>
  </PropertyGroup>
</Project>
