<?xml version="1.0" encoding="utf-8"?>

<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>GHIElectronics.TinyCLR.Devices.Gpio</id>
    <version>3.0.0.3000-prerelease</version>
    <authors>GHI Electronics, LLC</authors>
    <owners>GHI Electronics, LLC</owners>
    <projectUrl>https://ghielectronics.com/</projectUrl>
    <iconUrl>http://files.ghielectronics.com/downloads/Logos/GHIElectronicsTinyCLRNuGet.png</iconUrl>
    <licenseUrl>http://files.ghielectronics.com/downloads/TinyCLR/License.txt</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <description>Digital I/O pin (GPIO) control for TinyCLR.</description>
    <copyright>Copyright GHI Electronics, LLC 2022</copyright>
    <tags>TinyCLR TinyCLROS</tags>
    <dependencies>
      <dependency id="GHIElectronics.TinyCLR.Core" version="3.0.0.3000-prerelease" />
      <dependency id="GHIElectronics.TinyCLR.Native" version="3.0.0.3000-prerelease" />
    </dependencies>
  </metadata>
  <files>
    <!-- Standard bare package: just the TinyCLR-impl assemblies under lib/net48 (NuGet
         auto-references them). The dual-mode desktop-shim\ + tinyclr\ folders and the
         per-package build\net48\*.props were removed: the emulator replaces the desktop
         shim, and the centralized GHIElectronics.TinyCLR.Sdk package supplies NoStdLib +
         the MMP -> .pe pipeline (it MMPs the referenced lib/net48 assemblies). -->
    <file src="$TargetDir$GHIElectronics.TinyCLR.Devices.Gpio.dll" target="lib\net48" />
    <file src="$TargetDir$GHIElectronics.TinyCLR.Devices.Gpio.xml" target="lib\net48" />
    <!-- System.Device.Gpio compat DLL (Microsoft-style API). -->
    <file src="$TargetDir$System.Device.Gpio.dll" target="lib\net48" />
    <file src="$TargetDir$System.Device.Gpio.xml" target="lib\net48" />
    <!-- Thin consumer props: injects the Reference for legacy packages.config projects +
         stages the impl into pe\ for the debugger. No desktop-shim. -->
    <file src="$ProjectDir$GHIElectronics.TinyCLR.Devices.Gpio.props" target="build\net48" />
  </files>
</package>
