<?xml version="1.0" encoding="utf-8"?>

<!-- Consumer-side props imported by user projects via the NuGet package mechanism.
     Standardized (no desktop-shim): for legacy packages.config projects this injects the
     compile Reference to the lib/net48 impl and stages the impl DLL into pe\ for the debugger.
     SDK-style projects auto-reference lib/net48 (this Reference coexists harmlessly). The
     desktop-shim copies were removed - the TinyCLR emulator replaces desktop dual-mode; the
     impl-for-debugger copy now sources lib\net48 directly (the old tinyclr\ folder is gone). -->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Gpio">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Gpio.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRGpioImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Gpio.dll</_TinyCLRGpioImplSource>
    <_SystemDeviceGpioImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\System.Device.Gpio.dll</_SystemDeviceGpioImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRGpioImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRGpioImplSource)')">
    <Copy SourceFiles="$(_TinyCLRGpioImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Gpio.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopySystemDeviceGpioImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_SystemDeviceGpioImplSource)')">
    <Copy SourceFiles="$(_SystemDeviceGpioImplSource)" DestinationFiles="$(OutDir)pe\System.Device.Gpio.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
