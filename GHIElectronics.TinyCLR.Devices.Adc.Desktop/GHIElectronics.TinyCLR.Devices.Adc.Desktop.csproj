<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5B3C8D1E-9F2A-4E8B-A4C6-7D1F3E5B9C82}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>GHIElectronics.TinyCLR.Devices.Adc</RootNamespace>
    <!-- Output filename matches the TinyCLR-side library so it can replace
         it in user's bin\Debug\. Identity comes from AssemblyInfo.cs. -->
    <AssemblyName>GHIElectronics.TinyCLR.Devices.Adc</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <!-- Suppress harmless dual-mode-shim warnings:
         CS0436 = type forwarded but also defined locally
         CS0067 = events declared but never used (passthroughs)
         CS0649 = fields never assigned (no-op state placeholders) -->
    <NoWarn>CS0436;CS0067;CS0649</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Plain net48 library; references desktop System.dll. -->
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>

  <!-- Reference the Native.Desktop sister project so the shim's NativeApi /
       NativeApiType types resolve to the no-op Desktop versions
       (not the InternalCall-bearing impl). -->
  <ItemGroup>
    <ProjectReference Include="..\GHIElectronics.TinyCLR.Native.Desktop\GHIElectronics.TinyCLR.Native.Desktop.csproj">
      <Project>{3F8E6C5A-1D2B-4E9A-9C7F-8A5D2E7B4C13}</Project>
      <Name>GHIElectronics.TinyCLR.Native.Desktop</Name>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="Adc.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
