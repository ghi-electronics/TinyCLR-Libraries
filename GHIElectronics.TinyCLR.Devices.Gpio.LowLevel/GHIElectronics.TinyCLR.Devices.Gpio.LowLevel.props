<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRGpioLowLevelImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll</_TinyCLRGpioLowLevelImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRGpioLowLevelImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRGpioLowLevelImplSource)')">
    <Copy SourceFiles="$(_TinyCLRGpioLowLevelImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
