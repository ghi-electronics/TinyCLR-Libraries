<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Gpio.LowLevel">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRGpioLowLevelShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll</_TinyCLRGpioLowLevelShimSource>
    <_TinyCLRGpioLowLevelImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll</_TinyCLRGpioLowLevelImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRGpioLowLevelDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRGpioLowLevelShimSource)')">
    <Copy SourceFiles="$(_TinyCLRGpioLowLevelShimSource)" DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRGpioLowLevelImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRGpioLowLevelImplSource)')">
    <Copy SourceFiles="$(_TinyCLRGpioLowLevelImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Gpio.LowLevel.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
