<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.System.Device.Spi" Condition="Exists('$(MSBuildProjectDirectory)\packages.config')">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.System.Device.Spi.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRSystemDeviceSpiShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.System.Device.Spi.dll</_TinyCLRSystemDeviceSpiShimSource>
    <_TinyCLRSystemDeviceSpiImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.System.Device.Spi.dll</_TinyCLRSystemDeviceSpiImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRSystemDeviceSpiDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRSystemDeviceSpiShimSource)')">
    <Copy SourceFiles="$(_TinyCLRSystemDeviceSpiShimSource)" DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.System.Device.Spi.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRSystemDeviceSpiImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRSystemDeviceSpiImplSource)')">
    <Copy SourceFiles="$(_TinyCLRSystemDeviceSpiImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.System.Device.Spi.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
