<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRSystemDeviceSpiImplSource>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.System.Device.Spi.dll</_TinyCLRSystemDeviceSpiImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRSystemDeviceSpiImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRSystemDeviceSpiImplSource)')">
    <Copy SourceFiles="$(_TinyCLRSystemDeviceSpiImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.System.Device.Spi.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
