<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <Reference Include="GHIElectronics.TinyCLR.Devices.Usb" Condition="'$(NuGetProjectStyle)' != 'PackageReference'">
      <HintPath>$(MSBuildThisFileDirectory)..\..\lib\net48\GHIElectronics.TinyCLR.Devices.Usb.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <_TinyCLRUsbShimSource>$(MSBuildThisFileDirectory)..\..\desktop-shim\GHIElectronics.TinyCLR.Devices.Usb.dll</_TinyCLRUsbShimSource>
    <_TinyCLRUsbImplSource>$(MSBuildThisFileDirectory)..\..\tinyclr\GHIElectronics.TinyCLR.Devices.Usb.dll</_TinyCLRUsbImplSource>
  </PropertyGroup>
  <Target Name="CopyTinyCLRUsbDesktopShim" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUsbShimSource)')">
    <Copy SourceFiles="$(_TinyCLRUsbShimSource)" DestinationFiles="$(OutDir)GHIElectronics.TinyCLR.Devices.Usb.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
  <Target Name="CopyTinyCLRUsbImplForDebugger" AfterTargets="AfterBuild" Condition="Exists('$(_TinyCLRUsbImplSource)')">
    <Copy SourceFiles="$(_TinyCLRUsbImplSource)" DestinationFiles="$(OutDir)pe\GHIElectronics.TinyCLR.Devices.Usb.dll" OverwriteReadOnlyFiles="true" SkipUnchangedFiles="false" />
  </Target>
</Project>
