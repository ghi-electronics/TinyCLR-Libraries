<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{3F8E6C5A-1D2B-4E9A-9C7F-8A5D2E7B4C13}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>GHIElectronics.TinyCLR.Native</RootNamespace>
    <!-- Output filename matches the TinyCLR-side library so it can replace
         it in user's bin\Debug\. Identity (AssemblyName + Version + PKT)
         comes from AssemblyInfo.cs and MUST match TinyCLR-side. -->
    <AssemblyName>GHIElectronics.TinyCLR.Native</AssemblyName>
    <NoWarn>CS1591;CS1570;CS1572;CS1573;CS1574;CS1658</NoWarn>
    <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- This is a NORMAL .NET Framework 4.8 library project — desktop BCL
       references are needed. No <NoStdLib>; no link to TinyCLR's
       mscorlib.props. The shim's body is pure managed code, no native
       interop. -->
  <ItemGroup>
    <Reference Include="System" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="NativeApi.cs" />
    <Compile Include="NativeEventDispatcher.cs" />
    <Compile Include="DeviceInformation.cs" />
    <Compile Include="Flash.cs" />
    <Compile Include="Interop.cs" />
    <Compile Include="Interrupt.cs" />
    <Compile Include="Memory.cs" />
    <Compile Include="Power.cs" />
    <Compile Include="SystemTime.cs" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
